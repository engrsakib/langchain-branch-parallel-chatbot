# Groq API Key (Obtain from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Models (see https://console.groq.com/docs/models)
# GROQ_MODEL must support tool calling, which structured output relies on.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3

# App Configuration
APP_NAME=langchain-branch-parallel-chatbot
APP_ENV=development
LOG_LEVEL=INFO

DOCKER_CHATBOT_PORT_INTERNAL=8501
DOCKER_CHATBOT_PORT_EXTERNAL=8502 # This is the port that will be exposed to the outside world